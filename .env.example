# 复制本文件为 .env，然后填入你自己的 Key
# 获取地址：https://platform.deepseek.com/api_keys

DEEPSEEK_API_KEY=sk-your-key-here

# ---- 以下都是可选配置，不写就用默认值 ----

# 使用的模型，必须是 /models 接口返回的 id：
#   deepseek-flash   默认，支持图片输入，速度快
#   deepseek-v4-pro  纯文本，适合复杂推理
# DEEPSEEK_MODEL=deepseek-flash

# 采样温度，抽取类任务建议低一些
# DEEPSEEK_TEMPERATURE=0.3

# 单次请求超时（秒）
# DEEPSEEK_TIMEOUT=120

# 是否启用结果缓存（相同 JD / 底稿不会重复调用模型，省钱）
# JOB_AGENT_CACHE=true

# 是否打印详细日志
# JOB_AGENT_VERBOSE=false
